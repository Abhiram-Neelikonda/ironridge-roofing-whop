# Local dev only. On Whop hosting these are injected automatically — don't set them there.

# Your Whop business id (also set as site.brand.accountId in src/config/site.ts)
WHOP_ACCOUNT_ID=biz_XXXXXXXXXXXX

# Only for `npm run setup:whop` (creating the product + plans). Create under
# Developer in your Whop dashboard. Never commit this.
WHOP_API_KEY=whop_XXXXXXXXXXXX

# Protects the /admin invoice tool. Set the same value as an app secret:
#   whop apps secrets set --secret ADMIN_TOKEN=your-long-random-string
ADMIN_TOKEN=change-me

# Elements environment: "production" (default) or "sandbox" (not GA yet).
VITE_WHOP_ENV=production
